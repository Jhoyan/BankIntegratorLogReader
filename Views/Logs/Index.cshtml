@using System.Globalization
@model List<LogDiaResumo>
@{
    ViewData["Title"] = "Catálogo de logs";
    var culturaPtBr = CultureInfo.GetCultureInfo("pt-BR");
    var grupos = Model
        .GroupBy(d => new { d.Data.Year, d.Data.Month })
        .OrderByDescending(g => g.Key.Year)
        .ThenByDescending(g => g.Key.Month)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
    <div>
        <h1 class="mb-0">Catálogo de logs</h1>
        <p class="text-muted mb-0">Dias disponíveis para leitura na pasta <code>logs/</code>.</p>
    </div>
    @if (grupos.Count > 0)
    {
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-expandir-tudo">Expandir tudo</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-recolher-tudo">Recolher tudo</button>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-3">Nenhum arquivo de log encontrado na pasta <code>logs/</code>.</div>
}
else
{
    <div class="mt-3" id="catalogo-meses">
        @foreach (var (grupo, indice) in grupos.Select((g, i) => (g, i)))
        {
            var idMes = $"mes-{grupo.Key.Year}-{grupo.Key.Month:D2}";
            var nomeMes = culturaPtBr.DateTimeFormat.GetMonthName(grupo.Key.Month);
            var expandido = indice == 0;
            var dias = grupo.OrderByDescending(d => d.Data).ToList();
            var totalEntradasMes = dias.Sum(d => d.QuantidadeEntradas);

            <div class="card mb-2 grupo-mes">
                <div class="card-header p-0">
                    <button class="btn btn-mes w-100 d-flex justify-content-between align-items-center text-start"
                            type="button" data-bs-toggle="collapse" data-bs-target="#@idMes"
                            aria-expanded="@(expandido ? "true" : "false")" aria-controls="@idMes">
                        <span>
                            <span class="seta-mes">@(expandido ? "▾" : "▸")</span>
                            <strong class="text-capitalize">@nomeMes de @grupo.Key.Year</strong>
                        </span>
                        <span class="text-muted small">
                            @dias.Count dia(s) · @totalEntradasMes.ToString("N0", culturaPtBr) entradas
                        </span>
                    </button>
                </div>
                <div class="collapse @(expandido ? "show" : "")" id="@idMes">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Dia</th>
                                    <th>Entradas</th>
                                    <th>Tamanho</th>
                                    <th>Arquivo(s)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dia in dias)
                                {
                                    <tr>
                                        <td>@dia.Data.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                                        <td>@dia.QuantidadeEntradas.ToString("N0", culturaPtBr)</td>
                                        <td>@((dia.TamanhoBytes / 1024.0 / 1024.0).ToString("N1", culturaPtBr)) MB</td>
                                        <td><small class="text-muted">@string.Join(", ", dia.Arquivos)</small></td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-primary" asp-controller="Logs" asp-action="Dia" asp-route-data="@dia.Data.ToString("yyyy-MM-dd")">Ver logs</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/catalogo.js" asp-append-version="true"></script>
}
